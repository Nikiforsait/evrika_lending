# Optional: address of the account/progress API. By default the site uses /api on the same host
# (Vite proxies it to http://localhost:8787 in development, server/index.ts serves both in production).
VITE_API_URL=

# Dev test accounts live only in the local, git-ignored server/data/users.json; register any
# throwaway address through the form (password rule: 8+ characters with letters and digits).
